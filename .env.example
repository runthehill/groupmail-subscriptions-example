# ─────────────────────────────────────────────────────────────────────────────
# Groupmail Subscriptions API — example configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Your Groupmail Nemo API key. Looks like `nemo_...`. This is a SERVER-SIDE
# secret — it is sent in the X-API-ID header from this backend only and must
# never reach the browser. Needs the `write` scope (start/confirm/resend) and
# `read` scope (status). Create one in the Groupmail dashboard under API keys.
GROUPMAIL_API_KEY=nemo_replace_me

# API base URL. Production is the default; override for staging/local.
#   production : https://developer.groupmail.io   (canonical host)
#   staging    : https://fusion-api.onrender.com
GROUPMAIL_BASE_URL=https://developer.groupmail.io

# Comma-separated Group IDs (24-char hex ObjectIds) the form subscribes people to.
# One attempt can target 1–10 groups. Find IDs via `GET /groups` or the dashboard.
GROUPMAIL_GROUP_IDS=

# OPTIONAL — public HTTPS base URL where this app is reachable, used to build the
# email confirmation link as `${CONFIRM_BASE_URL}/confirm?token=...`. Required
# only for the `link`/`both` methods. The API rejects non-HTTPS confirmation
# URLs, so for local testing expose this app over a tunnel (e.g. ngrok) and put
# the https tunnel URL here. Leave blank to use the PIN-only flow locally.
CONFIRM_BASE_URL=

# How many proxy hops sit in front of this app, for deriving the subscriber IP.
#   false : (default) use the raw socket address — correct when directly exposed
#           or running locally. Never spoofable.
#   1     : trust exactly one proxy (e.g. a single load balancer / ingress).
# ⚠ Do NOT set `true` on a directly internet-exposed app: it trusts a
#   client-supplied X-Forwarded-For and lets attackers forge subscriber.ip,
#   defeating the per-IP abuse cap.
TRUST_PROXY=false

# Port for the example Express server.
PORT=3000

# Used only by `npm run smoke` — a real inbox you control. The smoke test sends
# a real confirmation email here and asks you to paste back the PIN.
TEST_EMAIL=
